flowchart TD
    I["输入：原文、任务类型、当前时间、时区"] --> V["上下文与长度检查"]
    V -->|"有效"| B["共享轻量 BERT 编码器"]
    V -->|"无效或超限"| U["无法可靠判断：保留原文"]
    B --> S["请求判断与片段候选头"]
    S --> P["组合候选：标题、时间、地点、备注"]
    B --> R["整组评分：边界和角色是否合理"]
    P --> R
    R --> W["选定最佳草案及备选差距"]
    W --> A["复制字段并组装提案"]
    A --> D["生产 KMP：仅归一化预测时间"]
    D --> H["硬校验：保真、重叠、字段、日期消费"]
    B --> Q["轻量正确性头：评估选定的整份提案"]
    W --> Q
    D --> Q
    Q --> C["独立校准：得到完整正确置信度 c"]
    H --> VALID{"草案完整且硬校验通过？"}
    VALID -->|"是"| G{"c 有效且达到隐藏阈值 T？"}
    VALID -->|"否"| BLOCK["ready=false；needsAI=true；显示 AI，需补充草案"]
    C --> G
    G -->|"是"| OK["ready=true；needsAI=false；隐藏 AI 按钮"]
    G -->|"否"| REVIEW["ready=true；needsAI=true；显示 AI，仍可添加"]
    U --> BLOCK
    OK --> SAVE["用户确认添加后才保存"]
    REVIEW --> SAVE
    REVIEW --> CHOICE["用户选择：AI 识别或手动补充"]
    BLOCK --> CHOICE
